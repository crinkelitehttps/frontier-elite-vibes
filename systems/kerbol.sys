# Kerbol, the star system of Kerbal Space Program, in place of 82 Eridani
# (sector 1,-1, next to Sol). Loaded by src/custom_system.c.
#
# Scaled up to real size with one rule: distances and radii x10, masses x100
# (that keeps each body's surface gravity: Kerbin comes out 6000 km, 0.89
# Earth masses, 1 g, 0.91 AU from a 0.88-sun star). KSP figures from memory,
# loosely; orbital phases are KSP's mean longitudes, roughly.
#
# ---- File format ----------------------------------------------------------
# key = the system replaced: its id in hex (the galaxy catalog's "id",
#       tools/galaxy_catalog; Sol is a925c600)
# name = the system's name on the galaxy map and everywhere else (optional)
# then one [Name] section per body, parents before their children; the
# name is what the game shows (21 characters at most). Fields:
#   type       one of: asteroid small_barren barren thin_atmosphere volcanic
#              ammonia methane water small_terraformed life life_small earth
#              terraformed thick_atmosphere small_gas_giant medium_gas_giant
#              large_gas_giant very_large_gas_giant brown_dwarf star_m_flare
#              star_m star_k star_g star_f star_a white_dwarf red_giant
#              trading_post orbital_station orbital_city surface_port
#              (the type sets the look, the radius and the atmosphere;
#              src/custom_system.c lists each one's radius)
#   parent     the body it orbits (or sits on); every body but the first
#   mass_kg    or mass_earth
#   orbit_km   orbit radius (semi-major axis)
#   ecc        eccentricity           incl_deg   inclination
#   phase_deg  where on its orbit it starts
#   tilt_deg   axial tilt             temp_k     surface temperature
#   radius_km  a planet's or star's radius, if not its type's (the look, the
#              atmosphere and the surface detail scale with it)
#   spin       rotation rate: 0 none, 1 about a day, each step twice as fast
#   lat_deg, lon_deg   a surface_port's place (east positive)
#   kind, model, seed  the game's raw numbers, to override the type's
# A starport (the last four types) is a working one: market, BBS, police.
# At most 60 bodies, 18 starports.
# ---------------------------------------------------------------------------

key = a91dc641
name = Kerbol

